<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="yam_arm" params="prefix parent *origin">

    <!-- Joint from parent to base_link -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <!-- Base Link -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="-0.000072281 0.000025257 0.0159932" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/base_link_collision.stl"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.6 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.000072281 0.000025257 0.0159932" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/base_link_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Joint 1 -->
    <joint name="${prefix}joint1" type="revolute">
      <origin xyz="0 0 0.0631" rpy="0 0 3.14159265"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.61799" upper="3.13" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 1 -->
    <link name="${prefix}link_1">
      <visual>
        <origin xyz="-0.00192861 -0.00795735 0.0208176" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_1_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="-0.00192861 -0.00795735 0.0208176" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_1_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.12415"/>
        <origin xyz="-0.00192861 -0.00795735 0.0208176" rpy="0 0 0"/>
        <inertia ixx="0.000180751" ixy="0.0" ixz="0.0" iyy="0.000145532" iyz="0.0" izz="0.0000589179"/>
      </inertial>
    </link>

    <!-- Joint 2 -->
    <joint name="${prefix}joint2" type="revolute">
      <origin xyz="0.000025 -0.02 0.0409" rpy="1.5708 0 1.5708"/>
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="3.65" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 2 -->
    <link name="${prefix}link_2">
      <visual>
        <origin xyz="0.132008 0.0000021 0.000293073" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_2_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0.132008 0.0000021 0.000293073" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_2_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.24434"/>
        <origin xyz="0.132008 0.0000021 0.000293073" rpy="0 0 0"/>
        <inertia ixx="0.0121902" ixy="0.0" ixz="0.0" iyy="0.0121318" iyz="0.0" izz="0.000683304"/>
      </inertial>
    </link>

    <!-- Joint 3 -->
    <joint name="${prefix}joint3" type="revolute">
      <origin xyz="0.264 0 0" rpy="3.14159265 0 0"/>
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="3.13" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 3 -->
    <link name="${prefix}link_3">
      <visual>
        <origin xyz="-0.121816 -0.054846 -0.000111108" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_3_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="-0.121816 -0.054846 -0.000111108" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_3_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.853698"/>
        <origin xyz="-0.121816 -0.054846 -0.000111108" rpy="0 0 0"/>
        <inertia ixx="0.00699732" ixy="0.0" ixz="0.0" iyy="0.00696112" iyz="0.0" izz="0.000788244"/>
      </inertial>
    </link>

    <!-- Joint 4 -->
    <joint name="${prefix}joint4" type="revolute">
      <origin xyz="-0.245 -0.06 0" rpy="0 0 0"/>
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.65" upper="1.65" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 4 -->
    <link name="${prefix}link_4">
      <visual>
        <origin xyz="-0.0569778 -0.0527104 0.000154878" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_4_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="-0.0569778 -0.0527104 0.000154878" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_4_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.463511"/>
        <origin xyz="-0.0769778 -0.0527104 0.000154878" rpy="0 0 0"/>
        <inertia ixx="0.000791532" ixy="0.0" ixz="0.0" iyy="0.000744733" iyz="0.0" izz="0.000282116"/>
      </inertial>
    </link>

    <!-- Joint 5 -->
    <joint name="${prefix}joint5" type="revolute">
      <origin xyz="-0.074 -0.0395 0.000025" rpy="1.5708 0 1.5708"/>
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 5 -->
    <link name="${prefix}link_5">
      <visual>
        <origin xyz="0.0000364861 0.00025665 0.0353526" rpy="1.5708 1.5708 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_5_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0.0000364861 0.00025665 0.0353526" rpy="1.5708 1.5708 0"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_5_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.350962"/>
        <origin xyz="0.0000364861 0.00025665 0.0353526" rpy="0 0 0"/>
        <inertia ixx="0.000197802" ixy="0.0" ixz="0.0" iyy="0.0001775" iyz="0.0" izz="0.000147402"/>
      </inertial>
    </link>

    <!-- Joint 6 -->
    <joint name="${prefix}joint6" type="revolute">
      <origin xyz="0 0.0353 0.0395" rpy="3.14159265 0 0"/>
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0944" upper="2.0944" effort="10" velocity="5.0"/>
    </joint>

    <!-- Link 6 (Wrist/Tool Flange) -->
    <link name="${prefix}link_6">
      <visual>
        <origin xyz="-0.000051018 -0.00269952 0.0481778" rpy="1.5708 1.5708 1.5708"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_6_collision.stl"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="-0.000051018 -0.00269952 0.0481778" rpy="1.5708 1.5708 1.5708"/>
        <geometry>
          <mesh filename="package://i2rt_description/meshes/yam/link_6_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.55366"/>
        <origin xyz="-0.000051018 -0.00269952 0.0581778" rpy="0 0 0"/>
        <inertia ixx="0.000956992" ixy="0.0" ixz="0.0" iyy="0.000799286" iyz="0.0" izz="0.000469547"/>
      </inertial>
    </link>

    <!-- TCP Frame (Tool Center Point) -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}tcp"/>
    </joint>

    <link name="${prefix}tcp"/>

    <!-- Grasp Frame -->
    <joint name="${prefix}grasp_joint" type="fixed">
      <origin xyz="0 0 0.1347" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}grasp_point"/>
    </joint>

    <link name="${prefix}grasp_point"/>

  </xacro:macro>

</robot>
