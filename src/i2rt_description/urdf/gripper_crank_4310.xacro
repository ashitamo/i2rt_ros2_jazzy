<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper_crank_4310" params="prefix parent *origin">

    <!-- Gripper base joint -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base"/>
    </joint>

    <!-- Gripper base link -->
    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.06"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
      </inertial>
    </link>

    <!-- Gripper joint (prismatic for position control, 0.0 = open, 1.0 = closed) -->
    <joint name="${prefix}gripper_joint" type="prismatic">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}left_finger"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="20" velocity="0.1"/>
    </joint>

    <!-- Left finger -->
    <link name="${prefix}left_finger">
      <visual>
        <origin xyz="0 0.015 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.05"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0.015 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.05"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 0.015 0.025" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- Right finger (mimic left finger) -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}right_finger"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.04" upper="0.0" effort="20" velocity="0.1"/>
      <mimic joint="${prefix}gripper_joint" multiplier="-1" offset="0"/>
    </joint>

    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0 -0.015 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.05"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 -0.015 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.05"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 -0.015 0.025" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
