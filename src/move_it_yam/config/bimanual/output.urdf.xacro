<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="output">
    <xacro:arg name="left_initial_positions_file" default="$(find move_it_yam)/config/bimanual/left_initial_positions.yaml" />
    <xacro:arg name="right_initial_positions_file" default="$(find move_it_yam)/config/bimanual/right_initial_positions.yaml" />

    <!-- Root link -->
    <link name="world"/>

    <!-- Import output urdf file -->
    <xacro:include filename="$(find yam_wif_gripper)/yam_st_urdf_with_linear_gripper_bimanual.urdf.xacro" />

    <!-- Import control_xacro -->
    <!-- <xacro:include filename="output.ros2_control.xacro" /> -->

    <xacro:yam_arm
        name="left_yam" 
        prefix="left" 
        parent="world" 
        initial_positions_file="$(arg left_initial_positions_file)">
        <origin xyz="0 1.5 0" rpy="0 0 0" />
    </xacro:yam_arm>

    <xacro:yam_arm
        name="right_yam" 
        prefix="right" 
        parent="world" 
        initial_positions_file="$(arg right_initial_positions_file)">
        <origin xyz="0 -1.5 0" rpy="0 0 0" />
    </xacro:yam_arm>

</robot>
